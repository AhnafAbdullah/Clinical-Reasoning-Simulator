{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinicalreasoningsim.app/schemas/clinical_case/v1",
  "title": "Clinical Case",
  "description": "Immutable clinical case document (Volume 3 §10-19, corrected edition).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "patient",
    "history",
    "physical_exam",
    "investigations",
    "diagnosis",
    "management",
    "rubric",
    "teaching_points"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "title", "difficulty", "specialty", "schema_version"],
      "properties": {
        "case_id": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "difficulty": {
          "type": "string",
          "enum": ["Basic", "Intermediate", "Advanced", "Extremely Hard"]
        },
        "specialty": { "type": "string" },
        "estimated_time": { "type": "integer", "minimum": 1 },
        "author": { "type": "string" },
        "schema_version": { "type": "integer", "const": 1 },
        "reviewed_by": { "type": "string" },
        "reviewer_credentials": { "type": "string" },
        "reviewed_at": { "type": "string" },
        "medical_signoff": { "type": "boolean" },
        "content_hash": { "type": "string" }
      }
    },
    "patient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "age", "gender"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "age": { "type": "integer", "minimum": 0, "maximum": 130 },
        "gender": { "type": "string" },
        "occupation": { "type": "string" },
        "weight": { "type": ["number", "null"] },
        "height": { "type": ["number", "null"] },
        "ethnicity": { "type": "string" },
        "personality": { "type": "string" },
        "communication_style": { "type": "string" }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chief_complaint"],
      "properties": {
        "chief_complaint": { "type": "string", "minLength": 1 },
        "history_of_presenting_illness": { "type": "object" },
        "past_medical_history": { "type": "array", "items": { "type": "string" } },
        "drug_history": { "type": "array", "items": { "type": "string" } },
        "family_history": { "type": "array", "items": { "type": "string" } },
        "social_history": { "type": "array", "items": { "type": "string" } },
        "review_of_systems": { "type": "object" }
      }
    },
    "physical_exam": {
      "type": "object",
      "description": "Keyed by system; each value is a free-form findings object.",
      "properties": {
        "general": { "type": "object" },
        "vitals": { "type": "object" },
        "cardiovascular": { "type": "object" },
        "respiratory": { "type": "object" },
        "abdomen": { "type": "object" },
        "neurology": { "type": "object" },
        "extremities": { "type": "object" }
      }
    },
    "investigations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["laboratory", "imaging", "bedside"],
      "properties": {
        "laboratory": { "type": "array", "items": { "$ref": "#/$defs/investigation" } },
        "imaging": { "type": "array", "items": { "$ref": "#/$defs/investigation" } },
        "bedside": { "type": "array", "items": { "$ref": "#/$defs/investigation" } }
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["final_diagnosis"],
      "properties": {
        "final_diagnosis": { "type": "string", "minLength": 1 },
        "differentials": { "type": "array", "items": { "type": "string" } },
        "explanation": { "type": "string" }
      }
    },
    "management": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "emergency_management": { "type": "array", "items": { "type": "string" } },
        "definitive_management": { "type": "array", "items": { "type": "string" } },
        "follow_up": { "type": "array", "items": { "type": "string" } },
        "patient_education": { "type": "array", "items": { "type": "string" } }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["history", "physical_exam", "investigations", "diagnosis", "treatment", "communication"],
      "properties": {
        "history": { "$ref": "#/$defs/rubric_item_section" },
        "physical_exam": { "$ref": "#/$defs/rubric_item_section" },
        "investigations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "weight": { "type": "number", "minimum": 0 },
            "expected": { "type": "array", "items": { "type": "string" } },
            "not_indicated": { "type": "array", "items": { "type": "string" } }
          }
        },
        "diagnosis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "weight": { "type": "number", "minimum": 0 },
            "accepted": { "type": "array", "items": { "type": "string" } },
            "acceptable_differentials": { "type": "array", "items": { "type": "string" } }
          }
        },
        "treatment": { "$ref": "#/$defs/rubric_item_section" },
        "communication": { "$ref": "#/$defs/rubric_item_section" }
      }
    },
    "teaching_points": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pearls": { "type": "array", "items": { "type": "string" } },
        "pitfalls": { "type": "array", "items": { "type": "string" } },
        "references": { "type": "array", "items": { "type": "string" } },
        "learning_objectives": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "investigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "result", "indicated"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "normal_range": { "type": "string" },
        "result": { "type": "string" },
        "interpretation": { "type": "string" },
        "clinical_significance": { "type": "string" },
        "indicated": {
          "type": "boolean",
          "description": "Whether this test is clinically indicated for this case (Vol 3 §15)."
        },
        "low_yield_response": {
          "type": "string",
          "description": "Standardised result returned when a valid test is ordered but not indicated."
        }
      }
    },
    "rubric_item_section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weight": { "type": "number", "minimum": 0 },
        "items": { "type": "array", "items": { "$ref": "#/$defs/rubric_item" } }
      }
    },
    "rubric_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "weight"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "detection_cues": { "type": "array", "items": { "type": "string" } },
        "weight": { "type": "number", "minimum": 0 },
        "required": { "type": "boolean" },
        "red_flag": { "type": "boolean" }
      }
    }
  }
}
