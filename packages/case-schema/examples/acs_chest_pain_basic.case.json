  "teaching_points": {
    "pearls": [
      "Inferior STEMI shows ST elevation in II, III and aVF.",
      "A normal first ECG does not exclude ACS — repeat it."
    ],
    "pitfalls": [
      "Anchoring on GORD because of diabetes-related atypical symptoms.",
      "Delaying reperfusion while awaiting troponin."
    ],
    "references": ["ESC Guidelines on acute MI in patients with ST-segment elevation"],
    "learning_objectives": [
      "Recognise a classic ACS presentation and risk factors.",
      "Select first-line investigations and avoid low-yield tests.",
      "Initiate time-critical STEMI management."
