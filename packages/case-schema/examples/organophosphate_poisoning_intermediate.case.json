  "diagnosis": {
    "final_diagnosis": "Organophosphate (cholinergic) poisoning",
    "differentials": ["Opioid overdose", "Carbamate poisoning", "Severe asthma/COPD", "Brainstem stroke"],
    "explanation": "A farmer with pesticide exposure presenting with the cholinergic toxidrome — miosis, hypersalivation, lacrimation, sweating, bronchorrhoea, bradycardia, fasciculations and reduced consciousness — with low serum cholinesterase, confirms organophosphate poisoning."
  },
  "management": {
    "emergency_management": [
      "ABC: protect the airway, suction secretions, high-flow oxygen, get senior/ICU help",
      "Decontaminate: remove clothing, wash skin; protect staff with PPE",
      "Atropine (large, escalating doses) until secretions dry and chest clears",
      "Pralidoxime (oxime) to reactivate acetylcholinesterase",
      "Benzodiazepines for seizures; continuous monitoring"
    ],
    "definitive_management": ["Titrate atropine to effect; ICU support; ventilation if needed"],
    "follow_up": ["Risk assessment for deliberate self-harm and psychiatric referral", "Occupational safety advice"],
    "patient_education": ["Use protective equipment when spraying", "Safe pesticide storage"]
