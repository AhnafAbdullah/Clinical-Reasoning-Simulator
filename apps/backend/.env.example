# Backend configuration (prefix CRS_). Copy to .env for local dev.
CRS_ENVIRONMENT=development
CRS_DATABASE_URL=postgresql+psycopg://crs:crs@localhost:5432/crs
CRS_SQL_ECHO=false

# Redis — generation buffer for resumable streaming + rate limiting.
CRS_REDIS_URL=redis://localhost:6379/0

# ── AIOS / LLM provider (OpenRouter is the single MVP provider) ────────────────
# Get a key at https://openrouter.ai/keys. Server-side only — never exposed to
# the frontend. Leave blank to run without live AI (tests use a fake provider).
CRS_OPENROUTER_API_KEY=
CRS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CRS_OPENROUTER_APP_URL=http://localhost:3000
CRS_OPENROUTER_APP_TITLE=Clinical Reasoning Simulator

# Model routing profiles -> concrete OpenRouter model ids.
CRS_MODEL_DEFAULT=openai/gpt-4o-mini
CRS_MODEL_REASONING=openai/gpt-4o
CRS_MODEL_LATENCY=openai/gpt-4o-mini

# Generation + retry tuning.
CRS_LLM_TIMEOUT_SECONDS=60
CRS_LLM_MAX_TOKENS=1024
CRS_LLM_MAX_RETRIES=2
CRS_LLM_BACKOFF_BASE_SECONDS=0.5

# ── Auth / JWT (Vol 5 §5) ──────────────────────────────────────────────────────
# MUST be overridden with a long random value in every real environment.
CRS_JWT_SECRET=dev-insecure-secret-change-me-in-production-0123456789
CRS_JWT_ALGORITHM=HS256
CRS_ACCESS_TOKEN_TTL_MINUTES=15
CRS_REFRESH_TOKEN_TTL_DAYS=14
# Google OAuth (only used when enable_google_login=true). Server-side only.
CRS_GOOGLE_CLIENT_ID=
CRS_GOOGLE_CLIENT_SECRET=

# ── Rate limiting (Vol 5 §24) — Redis-backed, fail-open if Redis is down ────────
CRS_RATE_LIMIT_ENABLED=true
CRS_RATE_LIMIT_MESSAGES_PER_MINUTE=20
CRS_RATE_LIMIT_SESSIONS_PER_HOUR=30
CRS_RATE_LIMIT_INVESTIGATIONS_PER_MINUTE=30
CRS_RATE_LIMIT_LOGIN_PER_MINUTE=10

# Feature flags.
CRS_ENABLE_STREAMING=true
CRS_ENABLE_GOOGLE_LOGIN=false
CRS_ENABLE_EVALUATION=true
CRS_ENABLE_ANALYTICS=false
